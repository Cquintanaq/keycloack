# Configuración Base de Datos
DB_NAME=keycloak
DB_USER=keycloak_admin
DB_PASSWORD=CambiaEstePasswordSeguro123!

# Usuario admin de Keycloak (docker-compose los mapea a KC_BOOTSTRAP_* internamente)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CambiaEstePasswordAdmin456!

# Configuración del Servidor
KC_PORT=443
KC_HOSTNAME=keycloak-pre.saludteprotege.cl
KC_FEATURES=upload-scripts
