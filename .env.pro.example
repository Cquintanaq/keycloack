# Copiar a .env.pro en el servidor y completar alli; no subir secretos a Git.
# Los campos vacios son intencionales: config --quiet debe rechazarlos.
# Destino informado: prerni-db-org01 / 172.16.1.14, PostgreSQL 18.6, cluster 18/org.
# PENDIENTE: confirmar ambiente; el host y la base indican PRE, no PRO.
# El DNS debe resolver desde el contenedor y coincidir con el certificado TLS.
PG_HOST=prerni-db-org01
# Puerto convencional pendiente de confirmar para el cluster 18/org.
PG_PORT=5432
PG_DATABASE=keycloak_pre
PG_USERNAME=kc_db_user
# Usar comillas simples si la clave contiene $ para evitar interpolacion Compose.
DB_PASSWORD=
PG_CA_FILE=

# URL publica completa, incluido https://; el hostname debe coincidir con el TLS.
KC_HOSTNAME=
KC_HTTPS_CERT_FILE=
KC_HTTPS_KEY_FILE=
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=

# Puerto local provisional. No cambia el servicio existente publicado en 443.
KEYCLOAK_PRO_PORT=8444