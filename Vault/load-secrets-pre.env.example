# Copiar a load-secrets-pre.env (nunca commitear ese archivo — ya está en .gitignore
# junto con load-secrets-pre.sh), completar los valores reales, y correr:
#
#   source load-secrets-pre.env
#   bash load-secrets-pre.sh
#
# El script también intenta cargar load-secrets-pre.env automáticamente si existe
# en el mismo directorio — el `source` manual de arriba es opcional pero explícito.
#
# Ver Sección "Runbook Operaciones" de .agents/plans/sprint 8/secrets-backend-vault-azure.md
# para el detalle de qué consume cada variable y en qué manifiesto.

# ============================================================
# Vault — conexión
# ============================================================
export VAULT_ADDR="https://rni-pre.saludenred.cl/vault-ui"   # o el endpoint interno del cluster
export VAULT_TOKEN=""   # root_token guardado al inicializar Vault (ver runbook, paso "Levantar el servicio de Vault")

# ============================================================
# OBLIGATORIAS — infraestructura real de PRE, el script falla si faltan
#
# PRE tiene 4 instancias PostgreSQL propias (mismo servidor físico, un
# volumen de disco por instancia — ver version/pre-master.yml). Un
# host/puerto por grupo, NO uno solo compartido:
#   CORE        -> organization, practitioner, notifications, versionmanager
#   PATIENT     -> patient
#   REPORTING   -> reporting
#   VACCINATION -> vaccination
#   AUDIT       -> audit (consumer_*; el producer_listener_* de audit-producer
#                  usa CORE/PATIENT porque escucha directo esas DBs vía outbox)
# ============================================================
export DB_HOST_CORE=""        # NO usar 172.16.1.74 (host de QA) sin confirmar con Ops
export DB_PORT_CORE="5432"
export DB_HOST_PATIENT=""     # NO usar 172.16.1.74 (host de QA) sin confirmar con Ops
export DB_PORT_PATIENT="5432"
export DB_HOST_REPORTING=""   # NO usar 172.16.1.74 (host de QA) sin confirmar con Ops
export DB_PORT_REPORTING="5432"
export DB_HOST_VACCINATION="" # NO usar 172.16.1.74 (host de QA) sin confirmar con Ops
export DB_PORT_VACCINATION="5432"
export DB_HOST_AUDIT=""       # NO usar 172.16.1.74 (host de QA) sin confirmar con Ops
export DB_PORT_AUDIT="5432"
export DB_USER=""
export DB_PASS=""
export KEYCLOAK_ISSUER=""   # ej. https://keycloak-pre.saludteprotege.cl:8444/realms/RNI-PRE — confirmar el puerto real con Ops, pre-master.yml no lo trae

# ============================================================
# OPCIONALES — dependen de un sistema externo (Keycloak/MINSAL/Azure Monitor).
# Si se dejan vacías, el script carga un placeholder "TODO: ..." y lo lista en el
# checklist final. Deben resolverse con valor real antes de dar PRE por operativo.
# ============================================================
export ORGANIZATION_KEYCLOAK_CLIENT_SECRET=""
export AZURE_MONITOR_CONNECTION_STRING=""
export GATEWAY_KEYCLOAK_CLIENT_SECRET=""
export GATEWAY_INTERNAL_CLIENT_SECRET=""
export GATEWAY_JWT_SECRET=""
# GATEWAY_ACCESS_KEY tiene default real (0DdrT08xEM, de version/pre-master.yml) —
# solo definir acá si cambia.
# export GATEWAY_ACCESS_KEY=""
export MINSAL_CLIENT_ID=""
export MINSAL_CLIENT_SECRET=""
export REPORTING_VACCINATION_READ_CONNECTION=""   # requiere crear antes un usuario de solo lectura real sobre vaccinationdb_write
export PATIENT_DB_PASSWORD_LEGACY=""   # clave DB_PASSWORD de patient, distinta de la connection string

# Sin consumidor todavía (OPA no tiene Vault Agent Injector hoy) — opcional, no bloquea el arranque
export OPA_ADMIN_TOKEN=""
export OPA_API_KEY=""
export OPA_JWT_SECRET=""

# ============================================================
# OPCIONALES — passwords puramente internas de RabbitMQ/Redis.
# Si se dejan vacías, el script las autogenera con `openssl rand` y las imprime al
# final para guardarlas en el gestor corporativo. Solo completar acá si ya existen
# valores fijados de antes (ej. brokers que ya están corriendo con esas credenciales).
# ============================================================
# export RABBIT_ADMIN_PASS=""
# export RABBIT_ORG_PASS=""
# export RABBIT_PATIENT_PASS=""
# export RABBIT_VACCINATION_PASS=""
# export RABBIT_AUDIT_CONSUMER_PASS=""
# export RABBIT_AUDIT_PRODUCER_PASS=""
# export RABBIT_REPORTING_PASS=""
# export RABBIT_NOTIF_ADMIN_PASS=""
# export RABBIT_NOTIF_COOKIE=""
# export RABBIT_NOTIF_SERVICE_PASS=""
# export RABBIT_EMAIL_SERVICE_PASS=""
# export RABBIT_SMS_SERVICE_PASS=""
# export RABBIT_MONITORING_PASS=""
# export RABBIT_SECURITY_ADMIN_PASS=""
# export RABBIT_SECURITY_COOKIE=""
# export RABBIT_APIGATEWAY_PASS=""
# export REDIS_SECURITY_PASS=""
# export REDIS_NOTIFICATIONS_PASS=""
# export REDIS_VERSIONMANAGER_PASS=""
